{
	"name": "sapphireit-publish-guard",
	"version": "1.1.0",
	"description": "A pre-publish quality checklist for WooCommerce products.",
	"license": "GPL-2.0-or-later",
	"private": true,
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"format": "wp-scripts format",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style",
		"test:unit:js": "wp-scripts test-unit-jest",
		"test:e2e": "wp-scripts test-playwright --config tests/e2e/playwright.config.js",
		"test:e2e:local": "node bin/e2e-local.js",
		"screenshots": "node bin/capture-screenshots.js",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:floor": "cp .wp-env.floor.json .wp-env.override.json && wp-env start --update",
		"env:current": "rm -f .wp-env.override.json && wp-env start --update",
		"makepot": "wp i18n make-pot . languages/sapphireit-publish-guard.pot --domain=sapphireit-publish-guard --slug=sapphireit-publish-guard --exclude=node_modules,vendor,tests,assets,bin,dist,.claude,artifacts,test-results,playwright-report",
		"package": "php bin/check-version.php --skip-pot && npm run build && npm run makepot && php bin/check-version.php && php bin/build-zip.php"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@testing-library/react": "^16.3.3",
		"@wordpress/api-fetch": "^7.56.0",
		"@wordpress/components": "^41.0.0",
		"@wordpress/date": "^5.56.0",
		"@wordpress/dom-ready": "^4.56.0",
		"@wordpress/e2e-test-utils-playwright": "^2.0.0",
		"@wordpress/element": "^8.8.0",
		"@wordpress/env": "^11.16.0",
		"@wordpress/i18n": "^6.29.0",
		"@wordpress/scripts": "^36.0.0",
		"globals": "^17.12.0",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"jquery": "3.7.1"
	},
	"engines": {
		"node": ">=20"
	}
}
