# Everything listed here is excluded from the release zip (bin/build-zip.php).
# One path per line, relative to the plugin root; `*` and `?` wildcards are allowed.
# Dotfiles and dot-directories are excluded at any depth whether or not they are listed;
# the ones below are named anyway so the list documents what exists.
# Verified in Phase 12: tests/, node_modules/, vendor/, dotfiles and .claude/.
# assets/ is shipped on purpose: WordPress.org requires the human-readable source of build/.

# Plan, agent notes and version control.
.claude
CLAUDE.md
.git
.github
.gitignore
.gitattributes
.distignore

# Tooling configuration and caches.
.editorconfig
.phpcs.cache
.phpunit.result.cache
.stylelintrc.json
.wp-env.json
.wp-env.floor.json
.wp-env.override.json
babel.config.js
eslint.config.cjs
jest.config.js
webpack.config.js
phpcs.xml.dist
phpunit.xml.dist
composer.json
composer.lock
package.json
package-lock.json

# Dev dependencies, tests and dev scripts.
bin
dist
node_modules
tests
vendor

# Empty companion of the style-only `admin` entry; nothing enqueues it.
build/admin.js
