# Dependencies. Both are dev-only; the release zip contains neither.
/node_modules/
/vendor/

# Tooling caches and local overrides.
/.phpcs.cache
/.phpunit.result.cache
/.wp-env.override.json

# build/ is deliberately NOT ignored: there is no CI here, and the plugin must be
# installable from a clean checkout.

# Local plan and agent notes. Kept on disk, never published.
/.claude/
/CLAUDE.md

# Release zip, produced by `npm run package`.
/dist/

# Local environment secrets. Never committed.
.env
.env.*
