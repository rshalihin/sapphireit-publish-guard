<?xml version="1.0"?>
<ruleset name="Product Publish Guard">
	<description>WordPress Coding Standards for the Product Publish Guard plugin.</description>

	<!-- What to scan. -->
	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/assets/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>
	<exclude-pattern>/.claude/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<!-- Targets. Both are the floors settled in coding-plan.md section 2. -->
	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.0-"/>

	<rule ref="WordPress">
		<!--
		Excluded: the plugin uses a PSR-4 file layout so the autoloader can be a
		ten-line string transform (src/Engine/Rule_Registry.php holds Rule_Registry),
		which conflicts with WordPress's class-{name}.php convention.
		-->
		<exclude name="WordPress.Files.FileName"/>
		<!--
		Excluded: every file holds exactly one class, and the bootstrap file holds only
		the two global functions. There is nothing to separate.
		-->
		<exclude name="Universal.Files.SeparateFunctionsFromOO"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<!-- Security sniffs are errors, not warnings (Definition of Done item 9). -->
	<rule ref="WordPress.Security">
		<type>error</type>
	</rule>
	<rule ref="WordPress.DB">
		<type>error</type>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="product-publish-guard"/>
			</property>
		</properties>
	</rule>

	<!--
	WooCommerce's own capabilities are not in the sniff's list of core capabilities.
	`manage_woocommerce` is the capability the plugin gates its settings and its publish
	override on (coding-plan.md section 9.1).
	-->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
				<element value="edit_products"/>
				<element value="edit_others_products"/>
				<element value="publish_products"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="sit_wcpg"/>
				<element value="SIT_WCPG"/>
				<element value="ProductPublishGuard"/>
			</property>
		</properties>
	</rule>

	<!--
	The REST suites have to stand a server up the way core does: assigning
	$wp_rest_server, firing rest_api_init and, for the nonce test, setting
	$wp_rest_auth_cookie. Those are WordPress's own global and WordPress's own hook, and
	prefixing either would mean testing something other than the shipped route. Only the
	two codes that fire on that are excluded, and only under /tests/.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- uninstall.php is procedural by design; it has no class to document. -->
	<rule ref="Squiz.Commenting.FileComment.MissingPackageTag">
		<exclude-pattern>/uninstall.php</exclude-pattern>
	</rule>
</ruleset>
